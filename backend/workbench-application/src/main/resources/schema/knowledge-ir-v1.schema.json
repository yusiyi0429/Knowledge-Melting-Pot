{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-melting-pot.local/schema/knowledge-ir-v1.schema.json",
  "title": "KnowledgeIR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "rules", "flows", "conflicts", "gaps", "sourceRefs"],
  "properties": {
    "schemaVersion": { "const": "knowledge-ir/v1" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "subSceneId", "roundId", "inputHash"],
      "properties": {
        "documentId": { "$ref": "#/$defs/uuid" },
        "subSceneId": { "$ref": "#/$defs/uuid" },
        "roundId": { "$ref": "#/$defs/uuid" },
        "inputHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "condition", "conclusion", "priority", "exceptions", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^R-[a-f0-9]{16}$" },
          "title": { "$ref": "#/$defs/text" },
          "condition": { "$ref": "#/$defs/text" },
          "conclusion": { "$ref": "#/$defs/text" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "exceptions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } },
          "sourceRefs": { "$ref": "#/$defs/sourceCodes" }
        }
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "nodes", "edges"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[A-Za-z0-9_-]{1,80}$" },
          "name": { "$ref": "#/$defs/text" },
          "nodes": {
            "type": "array",
            "maxItems": 5000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "critical", "sourceRefs"],
              "properties": {
                "id": { "type": "string", "pattern": "^N-[A-Za-z0-9_-]{1,80}$" },
                "label": { "$ref": "#/$defs/text" },
                "critical": { "type": "boolean" },
                "sourceRefs": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "$ref": "#/$defs/sourceCode" } }
              }
            }
          },
          "edges": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "source", "target", "label"],
              "properties": {
                "id": { "type": "string", "pattern": "^E-[A-Za-z0-9_-]{1,80}$" },
                "source": { "type": "string" },
                "target": { "type": "string" },
                "label": { "type": "string", "maxLength": 1000 }
              }
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^C-[A-Za-z0-9_-]{1,80}$" },
          "description": { "$ref": "#/$defs/text" },
          "sourceRefs": { "$ref": "#/$defs/sourceCodes" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^G-[A-Za-z0-9_-]{1,80}$" },
          "description": { "$ref": "#/$defs/text" }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/sourceRef" }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "sourceCode": { "type": "string", "pattern": "^SRC-[A-Za-z0-9_-]{1,100}$" },
    "sourceCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceCode" }
    },
    "nullableNonNegative": { "type": ["integer", "null"], "minimum": 0 },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "materialId", "materialSha256", "chunkId", "locatorType", "excerptHash"],
      "properties": {
        "code": { "$ref": "#/$defs/sourceCode" },
        "materialId": { "$ref": "#/$defs/uuid" },
        "materialSha256": { "$ref": "#/$defs/sha256" },
        "chunkId": { "$ref": "#/$defs/uuid" },
        "locatorType": { "enum": ["PDF_PAGE_PARAGRAPH", "DOCX_PARAGRAPH", "DOCX_TABLE_CELL", "XLSX_RANGE", "TXT_LINES"] },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "paragraph": { "$ref": "#/$defs/nullableNonNegative" },
        "table": { "$ref": "#/$defs/nullableNonNegative" },
        "sheet": { "type": ["string", "null"], "maxLength": 500 },
        "rowStart": { "$ref": "#/$defs/nullableNonNegative" },
        "rowEnd": { "$ref": "#/$defs/nullableNonNegative" },
        "colStart": { "$ref": "#/$defs/nullableNonNegative" },
        "colEnd": { "$ref": "#/$defs/nullableNonNegative" },
        "lineStart": { "$ref": "#/$defs/nullableNonNegative" },
        "lineEnd": { "$ref": "#/$defs/nullableNonNegative" },
        "excerptHash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
