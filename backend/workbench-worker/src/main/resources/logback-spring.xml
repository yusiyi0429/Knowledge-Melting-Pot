<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{48}%nopex%n</pattern>
        </encoder>
    </appender>

    <appender name="APP_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{48} - %msg%nopex%n</pattern>
        </encoder>
    </appender>

    <logger name="com.openjiuwen" level="WARN"/>
    <logger name="com.alibaba.dashscope" level="WARN"/>
    <logger name="com.openai" level="WARN"/>
    <logger name="okhttp3" level="WARN"/>
    <logger name="com.knowledgemeltingpot" level="INFO" additivity="false">
        <appender-ref ref="APP_CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
