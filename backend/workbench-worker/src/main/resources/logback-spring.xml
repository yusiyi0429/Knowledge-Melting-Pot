<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{48}%nopex%n</pattern>
        </encoder>
    </appender>

    <appender name="APP_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{48} - %msg%nopex%n</pattern>
        </encoder>
    </appender>

    <logger name="com.openjiuwen" level="WARN"/>
    <logger name="com.alibaba.dashscope" level="WARN"/>
    <logger name="com.openai" level="WARN"/>
    <logger name="okhttp3" level="WARN"/>
    <!-- Boot's root logger suppresses message bodies to avoid leaking provider
         payloads, but startup failure analysis contains only configuration and
         bean diagnostics and must remain actionable in an isolated Worker. -->
    <logger name="org.springframework.boot.diagnostics.LoggingFailureAnalysisReporter" level="ERROR" additivity="false">
        <appender-ref ref="APP_CONSOLE"/>
    </logger>
    <logger name="com.knowledgemeltingpot" level="INFO" additivity="false">
        <appender-ref ref="APP_CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
