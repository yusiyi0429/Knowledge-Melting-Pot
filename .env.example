KMP_DB_NAME=knowledge_melting_pot
KMP_DB_USER=kmp
KMP_DB_PASSWORD=change-me-for-local-only
KMP_MINIO_ROOT_USER=kmp-local
KMP_MINIO_ROOT_PASSWORD=change-me-for-local-only
KMP_BOOTSTRAP_ADMIN_USERNAME=admin
# Compose mounts this as a Docker secret. Use a unique value of at least 12 characters.
KMP_BOOTSTRAP_ADMIN_PASSWORD=
# Keep true behind the required TLS reverse proxy. Set false only for explicit local HTTP debugging.
KMP_SECURE_COOKIES=true
# Generate with: openssl rand -base64 32
# Compose mounts this value as /run/secrets/kmp_model_master_key; never commit a real key.
KMP_MODEL_MASTER_KEY=
KMP_ALLOWED_MODEL_HOSTS=api.openai.com,dashscope.aliyuncs.com
# Read-only Provider connectivity probe limits (ISO-8601 durations).
KMP_MODEL_TEST_CONNECT_TIMEOUT=PT5S
KMP_MODEL_TEST_REQUEST_TIMEOUT=PT10S
KMP_MODEL_TEST_MAX_REDIRECTS=2
# Dense embedding calls reuse the encrypted model connection and host allowlist.
KMP_EMBEDDING_REQUEST_TIMEOUT=PT1M
KMP_EMBEDDING_MAX_RESPONSE_BYTES=16777216
